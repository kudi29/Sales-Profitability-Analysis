# Page 1 Measures

### Total Sales

```DAX

Total Sales =
SUM ( vw_profit_by_category[sales] )

### Total Profit
Total Profit =
SUM ( vw_profit_by_category[benefit_per_order] )

### Profit Margin
Profit Margin % =
DIVIDE ( [Total Profit], [Total Sales], 0 )

### Total Orders
Total Orders =
DISTINCTCOUNT ( vw_profit_by_category[order_id] )

### Total Customers
Total Customers =
DISTINCTCOUNT ( vw_profit_by_category[customer_id] )

### Total Sales PY
Total Sales PY =
CALCULATE (
    [Total Sales],
    SAMEPERIODLASTYEAR ( dim_date[full_date] )
)

### Total Sales YoY %
Total Sales YoY % =
DIVIDE (
    [Total Sales] - [Total Sales PY],
    [Total Sales PY],
    BLANK ()
)

### Total Profit PY
Total Profit PY =
CALCULATE (
    [Total Profit],
    SAMEPERIODLASTYEAR ( dim_date[full_date] )
)

### Total Profit YoY %
Total Profit YoY % =
DIVIDE (
    [Total Profit] - [Total Profit PY],
    [Total Profit PY],
    BLANK ()
)

### Profit Margin % PY
Profit Margin % PY =
CALCULATE (
    [Profit Margin %],
    SAMEPERIODLASTYEAR ( dim_date[full_date] )
)

### Profit Margin % Change (pp)
Profit Margin % Change (pp) =
[Profit Margin %] - [Profit Margin % PY]

### Total Sales YoY Color
Total Sales YoY Color =
IF (
    [Total Sales YoY %] >= 0,
    "#0F6E56",
    "#D85A30"
)

### Total Profit YoY Color
Total Profit YoY Color =
IF (
    [Total Profit YoY %] >= 0,
    "#0F6E56",
    "#D85A30"
)

### Profit Margin Change Color
Profit Margin Change Color =
IF (
    [Profit Margin % Change (pp)] >= 0,
    "#0F6E56",
    "#D85A30"
)


### Sales Trend Alert
Sales Trend Alert =
VAR CurrentMargin = [Profit Margin %]
VAR PriorMargin = [Profit Margin % PY]

RETURN
    IF (
        NOT ISBLANK ( PriorMargin )
            && CurrentMargin < PriorMargin - 0.005,
        "Margin down "
            & FORMAT ( PriorMargin - CurrentMargin, "0.0%" )
            & " YoY",
        BLANK ()
    )


### Page Subtitle
Page Subtitle =
"Fiscal year "
    & SELECTEDVALUE ( dim_date[year], "All years" )
    & " performance"


# Page 2 Measures


### Avg Discount Amount
Avg Discount Amount =
AVERAGE ( 'reports vw_discount_impact'[order_item_discount] )


### Discount Band Sales
Discount Band Sales =
SUM ( 'reports vw_discount_impact'[sales] )


### Discount Band Profit
Discount Band Profit =
SUM ( 'reports vw_discount_impact'[benefit_per_order] )


### Discount Band Margin %
Discount Band Margin % =
DIVIDE ( [Discount Band Profit], [Discount Band Sales], 0 )


### Discount Band Order Count
Discount Band Order Count =
DISTINCTCOUNT ( 'reports vw_discount_impact'[order_id] )


### No Discount Baseline %
No Discount Baseline % =
13.6 / 100


### Discount Page Subtitle
Discount Page Subtitle =
SELECTEDVALUE (
    dim_product[category_name],
    "All categories"
)
    & " — Fiscal year "
    & SELECTEDVALUE ( dim_date[year], "All years" )


### Discount Volume Alert
Discount Volume Alert =
VAR WorstBand =
    TOPN (
        1,
        FILTER (
            VALUES ( 'reports vw_discount_impact'[discount_band] ),
            'reports vw_discount_impact'[discount_band]
                <> "0% - No discount"
        ),
        CALCULATE ( [Discount Band Order Count] ),
        DESC
    )

VAR WorstBandName =
    CONCATENATEX (
        WorstBand,
        'reports vw_discount_impact'[discount_band]
    )

RETURN
    "The "
        & WorstBandName
        & " band carries the most order volume and falls below the no-discount "
        & "baseline margin — the highest-impact band to review."


# Page 3 Measures

### Category Sales
Category Sales =
SUM ( vw_profit_by_category[sales] )


### Category Profit
Category Profit =
SUM ( vw_profit_by_category[benefit_per_order] )


### Category Margin %
Category Margin % =
DIVIDE ( [Category Profit], [Category Sales], 0 )


### Product Rank by Sales
Product Rank by Sales =
RANKX (
    ALL ( dim_product[product_name] ),
    [Total Sales],
    ,
    DESC
)


###Product Rank by Profit
Product Rank by Profit =
RANKX (
    ALL ( dim_product[product_name] ),
    [Total Profit],
    ,
    DESC
)


### Top 10 Products by Sales
Is Top 10 Product by Sales =
IF ( [Product Rank by Sales] <= 10, 1, 0 )


### Total Company Sales
Total Company Sales =
CALCULATE ( [Total Sales], ALL ( dim_product ) )


### % of Total Sales
% of Total Sales =
DIVIDE ( [Total Sales], [Total Company Sales], 0 )


### Margin vs Company Avg
Margin vs Company Avg =
[Category Margin %]
    - CALCULATE (
        [Profit Margin %],
        ALL ( dim_product )
    )


### Best Margin Category
Best Margin Category =
VAR BestCat =
    TOPN (
        1,
        VALUES ( dim_product[category_name] ),
        CALCULATE ( [Category Margin %] ),
        DESC
    )

RETURN
    CONCATENATEX (
        BestCat,
        dim_product[category_name]
    )


### Category Page Subtitle
Category Page Subtitle =
SELECTEDVALUE (
    dim_product[category_name],
    "All categories"
)
    & " — Fiscal year "
    & SELECTEDVALUE ( dim_date[year], "All years" )


